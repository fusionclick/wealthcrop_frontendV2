# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Node BSE proxy. Must come before the SPA fallback, otherwise every mutual-fund
  # call returns index.html with a 200 and the app silently gets HTML where it
  # expects JSON. VITE_NODE_URL=/api/bse in the build, so this path is what the
  # bundle calls.
  # The !-f guard stops the loop: the rewritten /api/bse/index.php is a real file,
  # so the rule does not fire a second time.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/bse/?(.*)$ /api/bse/index.php [QSA,L]

  # SPA fallback. The app is BrowserRouter, so /login and /mutual-funds are client-side
  # routes with no file behind them - without this Apache 404s every hard refresh and
  # every shared link. public/_redirects is Netlify syntax and Apache ignores it.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Cache policy. This block belongs HERE, in the repo, not on the server.
#
# It was applied straight to the live .htaccess twice — on 20 Sep and again on 29 Sep — and
# both times the very next frontend deploy silently wiped it, because Vite copies
# public/.htaccess into dist/ and deploy-wealthcrop.mjs does uploadFromDir(dist), which
# overwrites the server's copy. The fix kept "coming undone" for reasons nobody could see,
# and the cost was a full QA round of false "NOT FIXED" reports on work that had shipped.
#
# index.html is the only unhashed file and it points at everything else, so it must never be
# cached. Vite fingerprints every asset it emits, so those can be cached forever: a changed
# file gets a new name and the old name is never requested again.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>

  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
