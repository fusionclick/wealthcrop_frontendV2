# Host nginx (EC2 13.233.45.246) — NOT the container one.
# Bug: khelobindass.com + wealthcrop.co.in share one IP and one default vhost,
# so khelobindass serves the WealthCrop SPA (and TLS CN is wealthcrop → browser warns).
# Fix: one server_name list (or separate brands) + cert covering BOTH names.

# sudo certbot --nginx -d wealthcrop.co.in -d www.wealthcrop.co.in -d khelobindass.com -d www.khelobindass.com

server {
  listen 80;
  server_name wealthcrop.co.in www.wealthcrop.co.in khelobindass.com www.khelobindass.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name wealthcrop.co.in www.wealthcrop.co.in khelobindass.com www.khelobindass.com;

  # certbot paths (example)
  # ssl_certificate     /etc/letsencrypt/live/wealthcrop.co.in/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/wealthcrop.co.in/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;

  # proxy to docker/nginx on 8080 (or root /var/www/wealthcrop)
  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
